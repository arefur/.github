{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(pnpm *)",
      "Bash(npx tsc*)",
      "Bash(npx prettier*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(ls*)",
      "Bash(cat *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)"
    ],
    "ask": [
      "Bash(claude mcp add*)",
      "Bash(claude mcp add-json*)",
      "Bash(claude plugin install*)",
      "Bash(claude plugin marketplace add*)",
      "Edit(./.mcp.json)",
      "Edit(./.claude/settings.json)",
      "Write(./.mcp.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{console.log(JSON.parse(s).tool_input.file_path||'')}catch{}})\"); case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.json|*.css|*.md) npx --no-install prettier --write \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ]
  }
}